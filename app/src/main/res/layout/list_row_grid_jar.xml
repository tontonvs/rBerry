<?xml version= "1.0" encoding = "utf-8" ?>
<!-- Modified by Noven for rBerry: imported games are shown as cards. Same view ids as upstream. -->
<ru.playsoftware.j2meloader.applist.AppItemLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_game_card"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:minHeight="132dp"
    android:orientation="vertical"
    android:padding="12dp"
    tools:showIn="@layout/fragment_apps_list">

    <ImageView
        android:id="@+id/list_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_card_icon"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:scaleType="fitCenter"
        tools:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/card_title"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Example MIDlet Name" />

</ru.playsoftware.j2meloader.applist.AppItemLayout>
